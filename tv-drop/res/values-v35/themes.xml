<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Targeting Android 15 makes every screen draw under the status and navigation bars ("edge-to-edge").
         TV Drop's screens are laid out for the classic behavior, so keep it. -->
    <style name="TvDrop" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="TvDrop.Fullscreen" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
