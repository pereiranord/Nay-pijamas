<?xml version="1.0" encoding="utf-8"?>
<!-- The phone build ("celular"). Same app, same package name and the same signature as the TV build, without what
     only the TV uses. Above all: no accessibility service and no notification listener. Google Play Protect blocks
     the install of any app downloaded from the internet that declares either of them, and on the phone TV Drop
     uses neither (both serve the TV: touchpad/typing and "what is playing"). Android Developers, Play Protect
     warnings: https://developers.google.com/android/play-protect/warning-dev-guidance -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV only: installing and uninstalling apps sent to the TV, opening apps over others, storage per app,
         starting the receiver when the TV turns on -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application>
        <service android:name=".TvDropAccessibility" tools:node="remove" />
        <service android:name=".MediaListener" tools:node="remove" />
        <receiver android:name=".BootReceiver" tools:node="remove" />
        <receiver android:name=".InstallReceiver" tools:node="remove" />
    </application>
</manifest>
